class Solution {
    public int divide(int dividend, int divisor) {

        if (dividend == 0) {
            return 0;
        }

        boolean negative = (dividend < 0) != (divisor < 0);

        long a = Math.abs((long) dividend);
        long b = Math.abs((long) divisor);

        int count = 0;

        while (a >= b) {
            a = a - b;
            count++;
        }

        if (negative) {
            count = -count;
        }

        if (count > Integer.MAX_VALUE) {
            return Integer.MAX_VALUE;
        }

        return count;
    }
}
